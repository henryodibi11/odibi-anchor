    "inputs": {
        "required": [
            "source_df",
            "target"
        ],
        "optional": [
            "keys",
            "source_subject",
            "target_subject",
            "sample_limit"
        ]
    },
    "outputs": {
        "contract": "StandardContract",
        "kind": "pre_merge"
    },
    "dependencies": [],
    "tags": [
